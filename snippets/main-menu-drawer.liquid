{%- doc -%}
This component is used to render the primary menu drawer. It is used in the header component. It is rendered for
mobile, and for desktop on "drawer" mode.

@param {object} color_scheme - the color scheme to use for the menu
@param {object} primary_menu - the primary menu to display
@param {object} [secondary_menu] - show secondary links after the main links
@param {boolean} [show_nested_menu_indicator] - if true, it will show an arrow for menu with nested links
@param {boolean} [show_country_selector] - if set to true, the country selector will be displayed at the bottom
@param {boolean} [show_country_name] - if set to true, the country name will be displayed along the currency
@param {boolean} [show_country_flag] - if set to true, the country flag will be displayed along the currency
@param {boolean} [show_locale_selector] - if set to true, the locale selector will be displayed at the bottom
@param {boolean} [full_width] - if true, the drawer takes the full width on desktop and shows a media column
@param {object} [default_image] - the image shown in the media column when no link is hovered (full width mode only)
@param {object} [section]
{%- enddoc -%}

<header-menu-drawer id="menu-drawer" class="menu-drawer {% if full_width %}menu-drawer--full-width{% endif %} color-scheme color-scheme--{{ color_scheme.id }}">
  <template>
    <div part="overlay"></div>

    <div part="content">
      <slot></slot>
    </div>
  </template>

  {%- comment -%}
  This is the main panel being open when the drawer is initially open, and also contains social media and localization selectors
  {%- endcomment -%}

  <header-menu-drawer-panel id="menu-drawer-panel-main" data-main-panel class="menu-drawer__panel">
    <div class="menu-drawer__panel-body">
      {%- if primary_menu.links.size > 0 -%}
        <ul class="v-stack gap-3 faded-linklist unstyled-list">
          {%- for link in primary_menu.links -%}
            {%- liquid
              assign link_title_downcase = link.title | strip | downcase
              assign mega_menu_block = ''
        
              for block in section.blocks
                assign menu_item_downcase = block.settings.menu_item | strip | downcase
        
                if menu_item_downcase == link_title_downcase
                  assign mega_menu_block = block
                  break
                endif
              endfor
            -%}

            {%- liquid
              assign drawer_image = blank
              assign drawer_icon = blank

              if full_width and link.object != blank
                assign drawer_image = link.object.metafields.custom.header_image
                assign drawer_icon = link.object.metafields.custom.header_icon
              endif
            -%}

            {%- capture drawer_link_icon -%}
              {%- if drawer_icon != blank -%}
                <span class="menu-drawer__link-icon" aria-hidden="true">
                  {{- drawer_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' -}}
                </span>
              {%- endif -%}
            {%- endcapture -%}

            <li {% if drawer_image != blank %}data-drawer-image-trigger="{{ forloop.index }}"{% endif %}>
              {%- if link.levels == 0 and mega_menu_block == '' -%}
                <a href="{{ link.url }}" class="h4 w-full">
                  <div class="h-stack gap-3 sm:gap-5">
                    {{- drawer_link_icon -}}
                    {{- link.title -}}
                  </div>
                </a>
              {%- else -%}
                <button type="button" class="h4 text-start w-full" data-panel-toggle aria-controls="menu-drawer-panel-{{ forloop.index }}">
                  <div class="h-stack gap-3 sm:gap-5">
                    {{- drawer_link_icon -}}
                    {{- link.title -}}

                    {%- if show_nested_menu_indicator -%}
                      {%- render 'icon' with 'big-arrow-right', class: 'shrink-0 capped-icon' -%}
                    {%- endif -%}
                  </div>
                </button>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if primary_menu.links.size > 0 and secondary_menu.links.size > 0 -%}
        <hr class="menu-drawer__separator">
      {%- endif -%}

      {%- if secondary_menu.links.size > 0 -%}
        <ul class="v-stack gap-3 unstyled-list">
          {%- for link in secondary_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="subheading link-reversed">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- capture main_panel_footer -%}
      {%- capture social_media -%}
        {%- render 'social-media' -%}
      {%- endcapture -%}

      {%- if social_media != blank -%}
        <div class="menu-drawer__footer-item">
          {{- social_media -}}
        </div>
      {%- endif -%}

      {%- if show_country_selector or show_locale_selector or shop.customer_accounts_enabled -%}
        {%- comment -%}On desktop we show language, country and account link in the header directly, so we remove it from the drawer{%- endcomment -%}
        <div class="menu-drawer__footer-item lg:hidden">
          <div class="h-stack justify-between">
            {%- if show_country_selector or show_locale_selector -%}
              <div class="h-stack gap-5">
                {%- liquid
                  if show_country_selector
                    render 'localization-selector', type: 'country', show_country_name: show_country_name, show_country_flag: show_country_flag, id_prefix: 'menu-drawer'
                  endif

                  if show_locale_selector
                    render 'localization-selector', type: 'locale', id_prefix: 'menu-drawer' 
                  endif
                -%}
              </div>
            {%- endif -%}

            {%- if shop.customer_accounts_enabled -%}
              <shopify-account menu="{{ section.settings.customer_account_menu }}">
                <div slot="signed-out-avatar">
                  <div class="h-stack gap-2 5">
                    {%- render 'icon' with 'account', mobile_width: 16, width: section.settings.desktop_icon_size -%}
                    <span class="subheading">{{- 'header.general.account' | t -}}</span>
                  </div>
                </div>
              </shopify-account>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- if main_panel_footer != blank -%}
      <div class="menu-drawer__panel-footer">
        {{- main_panel_footer -}}
      </div>
    {%- endif -%}
  </header-menu-drawer-panel>

  {%- comment -%}
  Those are the secondary panels
  {%- endcomment -%}

  {%- for link in primary_menu.links -%}
    {%- liquid
      assign link_title_downcase = link.title | strip | downcase
      assign mega_menu_block = ''

      for block in section.blocks
        assign menu_item_downcase = block.settings.menu_item | strip | downcase

        if menu_item_downcase == link_title_downcase
          assign mega_menu_block = block
          break
        endif
      endfor
    -%}

    {%- if link.levels > 0 or mega_menu_block != '' -%}
      <header-menu-drawer-panel id="menu-drawer-panel-{{ forloop.index }}" class="menu-drawer__panel color-scheme color-scheme--{{ color_scheme.id }}">
        <div class="menu-drawer__panel-body">
          <div class="v-stack gap-5.5">
            <button type="button" class="back-button justify-self-start" data-panel-toggle aria-controls="menu-drawer-panel-main">
              {%- render 'icon' with 'back-arrow', direction_aware: true -%}
              <span class="subheading">{{- 'header.general.navigation_back' | t -}}</span>
            </button>

            <div class="v-stack gap-8">
              {%- if link.levels > 0 -%}
                {%- if link.levels == 1 -%}
                  <ul class="v-stack gap-2.5 unstyled-list">
                    {%- for sub_link in link.links -%}
                      <li>
                        <a href="{{ sub_link.url }}" class="link-reversed">{{ sub_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <div class="v-stack gap-8">
                    {%- for sub_link in link.links -%}
                      <div class="v-stack justify-items-start gap-4">
                        <a href="{{ sub_link.url }}" class="subheading text-subdued link-reversed">{{ sub_link.title }}</a>

                        {%- if sub_link.links.size > 0 -%}
                          <ul class="v-stack gap-2.5 unstyled-list">
                            {%- for sub_sub_link in sub_link.links -%}
                              <li>
                                <a href="{{ sub_sub_link.url }}" class="link-reversed">{{ sub_sub_link.title }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if mega_menu_block != blank -%}
                {%- render 'menu-promo', block: mega_menu_block, context: 'drawer' -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </header-menu-drawer-panel>
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%}
  Media column for the full width drawer mode. All link images are stacked, and the active one is revealed
  through CSS only (hover on the main panel, or when a secondary panel is open)
  {%- endcomment -%}

  {%- if full_width -%}
    {%- liquid
      assign drawer_media_default = default_image
      assign drawer_media_indices = ''
    -%}

    {%- capture drawer_media_items -%}
      {%- for link in primary_menu.links -%}
        {%- liquid
          assign drawer_image = blank

          if link.object != blank
            assign drawer_image = link.object.metafields.custom.header_image
          endif

          if drawer_image == blank
            continue
          endif

          if drawer_media_default == blank
            assign drawer_media_default = drawer_image
          endif

          assign drawer_media_indices = drawer_media_indices | append: forloop.index | append: ','
        -%}

        <div class="menu-drawer__media-item" data-drawer-image="{{ forloop.index }}">
          {%- render 'media', media: drawer_image, preload: false, sizes: '50vw', autoplay: true, loop: true, controls: false, show_play_button: false -%}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if drawer_media_default != blank -%}
      <div class="menu-drawer__media" aria-hidden="true">
        <div class="menu-drawer__media-item menu-drawer__media-item--default">
          {%- render 'media', media: drawer_media_default, preload: false, sizes: '50vw', autoplay: true, loop: true, controls: false, show_play_button: false -%}
        </div>
        {{- drawer_media_items -}}
      </div>

      <script>
        document.getElementById('menu-drawer').addEventListener('dialog:after-hide', (event) => {
          event.currentTarget.querySelector('.menu-drawer__media').style.opacity = '';
        });
      </script>

      {%- assign drawer_media_indices = drawer_media_indices | split: ',' -%}

      {%- if drawer_media_indices.size > 0 -%}
        <style>
          {%- for index in drawer_media_indices -%}
            .menu-drawer--full-width:has([data-drawer-image-trigger="{{ index }}"]:hover, #menu-drawer-panel-{{ index }}.is-visible) [data-drawer-image="{{ index }}"] {
              opacity: 1;
            }

            .menu-drawer--full-width:has([data-drawer-image-trigger="{{ index }}"]:hover, #menu-drawer-panel-{{ index }}.is-visible) .menu-drawer__media-item--default {
              opacity: 0;
            }
          {%- endfor -%}
        </style>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
</header-menu-drawer>