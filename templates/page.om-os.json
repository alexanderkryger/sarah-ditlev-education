{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"color_scheme":"","show_title":true,"content_width":"md"}},"image_with_text_overlay_bXbybg":{"type":"image-with-text-overlay","blocks":{"subheading_WMNkXA":{"type":"subheading","settings":{"text":"OM SARAH"},"blocks":{}},"heading_YUNUJQ":{"type":"heading","settings":{"text":"Frisør, farvespecialist og underviser","heading_size":"h2","html_tag":"p","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_KUpdbD":{"type":"rich-text","name":"t:blocks.rich_text.name","settings":{"text":"<p>Jeg lærer frisører at skabe farver, der holder, med teknikker de kan bruge mandag morgen.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["subheading_WMNkXA","heading_YUNUJQ","rich_text_KUpdbD"],"name":"t:sections.image_with_text_overlay.name","settings":{"color_scheme":"","allow_transparent_header":true,"image_size":"auto","image":"shopify:\/\/shop_images\/sarah_ditliv_om_os_16_9.png","mobile_image":"shopify:\/\/shop_images\/sarah_ditliv_om_os_9_16.png","overlay_color":"#000000","overlay_opacity":20,"enable_sticky_content":false,"content_width":"sm","desktop_text_position":"sm:place-self-center","mobile_text_position":"place-self-center"}},"text_with_media_iPaM8q":{"type":"text-with-media","blocks":{"subheading_4bwnUC":{"type":"subheading","settings":{"text":"Historien","position":"top_left"}},"heading_gbE7HM":{"type":"heading","settings":{"text":"Fra stolen til platformen","heading_tag":"h1","position":"top_left","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_LNUNJa":{"type":"richtext","settings":{"text":"<p>Jeg hedder Sarah Ditlev og driver Sarah Ditlev Studio i Silkeborg. [Jeg har arbejdet med farve i X år] og har brugt det meste af tiden på at finde ud af, hvorfor nogle farver holder flot i måneder, og andre falder sammen efter to uger.<\/p><p>Svaret ligger sjældent i produktet. Det ligger i placeringen, i forståelsen af hårets fald, og i de små valg undervejs, som ingen lærte os i skolen. Det er det, jeg underviser i. [Først fysisk, hos X og på scener som Icon Hair,] og nu også online, så du kan se hver folie igen og igen, uanset hvor du står.<\/p>","position":"bottom_left"}}},"block_order":["subheading_4bwnUC","heading_gbE7HM","richtext_LNUNJa"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-1","content_position":"start","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":true,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/sarah-ditlev-kursus.png","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}},"steps_f7xCfd":{"type":"steps","blocks":{"step_qnBiEc":{"type":"step","settings":{"image_width":48,"heading":"Forstå hvorfor","heading_size":"h6","text":"<p>En teknik er ikke lært, før du ved hvorfor den virker. Så kan du rette til, når kunden ikke ligner modellen.<\/p>","button_text":"","button_link":"","button_style":"outline","button_open_in_new_tab":false}},"step_rUMdVP":{"type":"step","settings":{"image_width":48,"heading":"Detaljerne afgør det","heading_size":"h6","text":"<p>Forskellen på godt og fantastisk ligger i pakkens vinkel, mængden i vævningen og hvor din face frame stopper.<\/p>","button_text":"","button_link":"","button_style":"outline","button_open_in_new_tab":false}},"step_JtMibp":{"type":"step","settings":{"image_width":48,"heading":"Lavet til salonen","heading_size":"h6","text":"<p>Alt jeg underviser i skal kunne udføres på en almindelig kunde, på en almindelig dag, til en pris der giver mening.<\/p>","button_text":"","button_link":"","button_style":"outline","button_open_in_new_tab":false}}},"block_order":["step_qnBiEc","step_rUMdVP","step_JtMibp"],"name":"Steps","settings":{"color_scheme":"scheme-5","subheading":"","title":"Det tror jeg på","heading_tag":"h4","content":"","text_alignment":"left","columns_desktop":3,"show_numbers":false,"show_card_border":true,"add_vertical_spacing":true,"add_horizontal_spacing":true}},"text_with_media_bgDTL7":{"type":"text-with-media","blocks":{"subheading_79Bz6K":{"type":"subheading","settings":{"text":"Historien","position":"top_left"}},"heading_M4cBLQ":{"type":"heading","settings":{"text":"Filmet bag stolen, ikke i et studie","heading_tag":"h1","position":"top_left","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_39WKtk":{"type":"richtext","settings":{"text":"<p>Jeg hedder Sarah Ditlev og driver Sarah Ditlev Studio i Silkeborg. [Jeg har arbejdet med farve i X år] og har brugt det meste af tiden på at finde ud af, hvorfor nogle farver holder flot i måneder, og andre falder sammen efter to uger.<\/p><p>Svaret ligger sjældent i produktet. Det ligger i placeringen, i forståelsen af hårets fald, og i de små valg undervejs, som ingen lærte os i skolen. Det er det, jeg underviser i. [Først fysisk, hos X og på scener som Icon Hair,] og nu også online, så du kan se hver folie igen og igen, uanset hvor du står.<\/p>","position":"bottom_left"}}},"block_order":["subheading_79Bz6K","heading_M4cBLQ","richtext_39WKtk"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-1","content_position":"end","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":true,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/sarah_ditliv_om_os_1_1.png","secondary_video":"shopify:\/\/files\/videos\/menu_om_os.mp4","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}}},"order":["main","image_with_text_overlay_bXbybg","text_with_media_iPaM8q","steps_f7xCfd","text_with_media_bgDTL7"]}