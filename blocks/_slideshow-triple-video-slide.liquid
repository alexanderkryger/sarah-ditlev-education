{%- capture slide -%}
  {%- liquid
    assign is_first = false

    for section_block in section.blocks
      if block.id == section_block.id and forloop.first
        assign is_first = true
      endif
    endfor

    if section.settings.autoplay and section.blocks.size > 1
      assign loop_video = false
    else
      assign loop_video = true
    endif

    comment
      Mobile shows one video. Either the explicit mobile upload, or the desktop video selected in "mobile_video_source".
    endcomment

    assign mobile_video = block.settings.mobile_video

    if mobile_video == blank
      case block.settings.mobile_video_source
        when '2'
          assign mobile_video = block.settings.video_2
        when '3'
          assign mobile_video = block.settings.video_3
        else
          assign mobile_video = block.settings.video_1
      endcase
    endif

    case block.settings.gap
      when 'small'
        assign gap_value = '.5rem'
      when 'medium'
        assign gap_value = '1rem'
      when 'large'
        assign gap_value = 'var(--container-gutter)'
      else
        assign gap_value = '0px'
    endcase
  -%}

  <div class="content-box triple-video-slide {% if section.settings.image_size == 'auto' %}triple-video-slide--auto{% endif %} min-h-{{ section.settings.image_size }}">
    <div class="content-box__background-media with-overlay" style="--overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }}">
      <div class="triple-video" style="--triple-video-gap: {{ gap_value }}">
        {%- for index in (1..3) -%}
          {%- liquid
            case index
              when 1
                assign item_video = block.settings.video_1
              when 2
                assign item_video = block.settings.video_2
              else
                assign item_video = block.settings.video_3
            endcase
          -%}

          <div class="triple-video__item triple-video__item--desktop">
            {%- if item_video != blank -%}
              {%- render 'media', media: item_video, playsinline: true, autoplay: false, loop: loop_video, muted: true, controls: false, preload: is_first, show_play_button: false -%}
            {%- else -%}
              {{- 'hero-apparel-' | append: index | placeholder_svg_tag: 'size-full' -}}
            {%- endif -%}
          </div>
        {%- endfor -%}

        <div class="triple-video__item triple-video__item--mobile">
          {%- if mobile_video != blank -%}
            {%- render 'media', media: mobile_video, playsinline: true, autoplay: false, loop: loop_video, muted: true, controls: false, preload: is_first, show_play_button: false -%}
          {%- else -%}
            {{- 'hero-apparel-1' | placeholder_svg_tag: 'size-full' -}}
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="{{ block.settings.mobile_content_position }} {{ block.settings.desktop_content_position }}" style="max-width: {{ block.settings.content_max_width }}px">
      <div class="prose prose-justify-{{ block.settings.mobile_content_position | split: '-' | last }} sm:prose-justify-{{ block.settings.desktop_content_position | split: '-' | last }}">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
{%- endcapture -%}

<style>
  /* With "Original image ratio" the slide takes the ratio of the videos: one 9:16 on mobile, three side by side on desktop */
  .triple-video-slide--auto {
    aspect-ratio: 9 / 16;
    width: 100%;
  }

  @media screen and (min-width: 700px) {
    .triple-video-slide--auto {
      aspect-ratio: 27 / 16;
    }
  }

  .triple-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--triple-video-gap, 0px);
    display: grid;
  }

  .triple-video__item {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .triple-video__item > *,
  .triple-video__item video,
  .triple-video__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .triple-video__item--desktop {
    display: none;
  }

  @media screen and (min-width: 700px) {
    .triple-video {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .triple-video__item--desktop {
      display: block;
    }

    .triple-video__item--mobile {
      display: none;
    }
  }
</style>

{%- if block.settings.slide_link != blank -%}
  <a href="{{ block.settings.slide_link }}" class="slideshow__slide {% if is_first %}is-selected{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" data-slide-type="video" role="group" {{ block.shopify_attributes }}>
    {{- slide -}}
  </a>
{%- else -%}
  <div class="slideshow__slide {% if is_first %}is-selected{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" data-slide-type="video" role="group" {{ block.shopify_attributes }}>
    {{- slide -}}
  </div>
{%- endif -%}

